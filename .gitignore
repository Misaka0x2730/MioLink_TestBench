# Ignore build artifacts and generated files
build/*

# Ignore embedded-cli output file (generated during build)
firmware/external/embedded-cli/lib/shl/*

# Ignore IDE-specific files
.vscode/
.idea/
.cache/

# Ignore Python cache files
*/__pycache__/

# Temporarily ignore hc32f460 SDK
firmware/external/hc32f460_ddl/

# Ignore compiled Python files
*.pyc
*.pyd

# Ignore MacOS specific files
.DS_Store

# Ignore KiCad generated/temporary files in hardware projects
hardware/**/*-backups/
hardware/**/*.bak
hardware/**/*.bck
hardware/**/*.kicad_pcb-bak
hardware/**/*.kicad_sch-bak
hardware/**/*.sch-bak
hardware/**/*-save.kicad_pcb
hardware/**/*-save.pro
hardware/**/_autosave-*
hardware/**/*~
hardware/**/*.000
hardware/**/*.tmp
hardware/**/*.lck

# Ignore KiCad per-user local settings and caches (not project sources)
hardware/**/*.kicad_prl
hardware/**/fp-info-cache

# Ignore KiCad exported netlists / BOM / autorouter files
hardware/**/*.net
hardware/**/*.dsn
hardware/**/*.ses