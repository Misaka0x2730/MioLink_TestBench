# Ignore build artifacts and generated files
build/*

# Ignore embedded-cli output file (generated during build)
firmware/external/embedded-cli/lib/shl/*

# Ignore IDE-specific files
.vscode/
.idea/
.cache/

# Ignore Python cache files
*/__pycache__/

# Temporarily ignore hc32f460 SDK
firmware/external/hc32f460_ddl/

# Ignore compiled Python files
*.pyc
*.pyd

# Ignore MacOS specific files
.DS_Store